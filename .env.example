# AI-Neurocare deployment configuration (copy to .env and adjust)

# --- Gateway ---
GATEWAY_PORT=8080
# Comma-separated API keys. UNSET = open (dev only!). Set in production.
GATEWAY_API_KEYS=

# --- LLM provider ([OI]-compatible OpenAI-style endpoint) ---
# Cloud example (Gemini OpenAI-compat endpoint):
#   LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_API_KEY=<your-key>
#   LLM_MODEL=gemini-2.0-flash
# Fully-local example (Ollama, `ollama pull llama3.1:8b`):
#   LLM_API_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.1:8b
# Unset => the engine serves deterministic fallback templates (no external call).
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- PPG microservice ---
PPG_ENGINE_PORT=8001
